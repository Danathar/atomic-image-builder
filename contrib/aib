#!/usr/bin/env bash
#
# aib — run Atomic Image Builder as a container. No local clone or
# dependency install required; podman and cosign are the prerequisites.
# cosign is needed to verify the published image's signature before running
# it; AIB_SKIP_VERIFY=1 drops that requirement and the protection with it.
#
# Install:
#   curl -fsSL https://raw.githubusercontent.com/Danathar/atomic-image-builder/main/contrib/aib -o ~/.local/bin/aib
#   chmod +x ~/.local/bin/aib
#
# Usage:
#   aib
#
# Config:
#   AIB_IMAGE         Image to run. Default:
#                     ghcr.io/danathar/atomic-image-builder:latest
#   AIB_SKIP_VERIFY   Set to any value to skip signature verification. Needed
#                     for an offline run, or on a host without cosign. This
#                     runs an unverified image, so the wrapper says so loudly.
#
# What this script mounts or passes into the container, and why:
#
#   cosign verify, then run by digest
#       This wrapper is the path where nobody thinks about pulling: it fetches
#       and executes a mutable tag on every run, as root in the container,
#       with the host's GitHub token forwarded in. A signature nothing checks
#       protects nobody, so the published image is verified here rather than
#       only in a one-time step in the install docs. The digest cosign
#       verified is the digest podman is given, because verifying a tag and
#       then letting podman resolve it again leaves a window for the tag to
#       move in between.
#
#       Verification applies only to images this project publishes. Point
#       AIB_IMAGE at your own build and it is left alone -- being forced
#       through this repository's certificate identity would just fail.
#
#   --pull=newer  (unverified paths only)
#       Checks the registry for a newer image on every run and pulls only when
#       the digest differs. See the note by podman_args below for why this is
#       not left at podman's default. The verified path does its own explicit
#       pull instead, because it has to resolve a digest before running.
#
#   -e GH_TOKEN
#       When the host has `gh` logged in, forwards a token so the container
#       does not need its own login. The value is exported in this wrapper's
#       environment and is never placed in the Podman command line or written
#       to disk by this script.
#
#   -v aib-gh:/root/.config/gh
#       Used instead of GH_TOKEN when the host has no working `gh` login.
#       This is a podman-managed named volume, not a bind mount, so an
#       in-container `gh auth login` (device-code flow) persists across runs
#       without ever touching the host's own ~/.config/gh.
#
#   -v aib-dnf-cache:/var/cache/libdnf5
#       Persists the DNF metadata the tool's package search reads. The image
#       ships with no metadata (the Containerfile ends in `dnf5 clean all`),
#       so the first search offers to download it; without this volume the
#       container's `--rm` would throw that away and charge the user the same
#       download on every run. Also a podman-managed named volume, so it
#       never touches the host's own dnf caches.
#
#   -v <tmp file>:<path>:ro,Z  and  -e AIB_RPM_OSTREE_STATUS_FILE=<path>
#       When the host has `rpm-ostree`, this script captures
#       `rpm-ostree status --json` from the host (the container has no way
#       to reach the host's rpm-ostreed itself) and mounts the result
#       read-only, so the tool's Scan OS menu can read real host state. If
#       the host has no rpm-ostree, this is skipped silently — the Scan OS
#       menu will just report it is unavailable. The temp file is removed
#       on exit.
#
#   -v /etc/localtime:/etc/localtime:ro
#       So the daily-rebuild note the tool prints shows the correct local
#       time instead of defaulting to UTC.
#
# Known limitation: local Podman test builds are not available through this
# wrapper (no podman-socket passthrough in v1). Inside the container the
# tool's own "podman is required to run a local test build" message is the
# expected, correct degradation — see README.md.

set -euo pipefail

AIB_PUBLISHED_REPO="ghcr.io/danathar/atomic-image-builder"
AIB_IMAGE="${AIB_IMAGE:-$AIB_PUBLISHED_REPO:latest}"

# Byte-identical to the invocation in docs/installing.md, and to what
# publish-image.yml signs with. The refs/(heads/main|tags/.+) alternation is
# load-bearing: :latest is signed from a push to main, but a release is
# published from a tag ref, so its certificate identity ends @refs/tags/<tag>.
AIB_CERT_IDENTITY='^https://github\.com/Danathar/atomic-image-builder/\.github/workflows/publish-image\.yml@refs/(heads/main|tags/.+)$'
AIB_CERT_ISSUER='https://token.actions.githubusercontent.com'

if ! command -v podman >/dev/null 2>&1; then
    echo "aib: podman is required but was not found on PATH. Install podman and try again." >&2
    exit 1
fi

# Verify only what this project publishes. A user running their own build must
# not be pushed through this repository's certificate identity, which their
# image cannot satisfy.
verify_image=no
case "$AIB_IMAGE" in
    "$AIB_PUBLISHED_REPO" | "$AIB_PUBLISHED_REPO":* | "$AIB_PUBLISHED_REPO"@*)
        verify_image=yes
        ;;
esac

if [ -n "${AIB_SKIP_VERIFY:-}" ] && [ "$verify_image" = yes ]; then
    echo "aib: WARNING - AIB_SKIP_VERIFY is set. Running $AIB_IMAGE without" >&2
    echo "aib: verifying its signature. Unset AIB_SKIP_VERIFY to restore the check." >&2
    verify_image=no
fi

podman_args=(--rm -it)
run_image="$AIB_IMAGE"

if [ "$verify_image" = no ]; then
    # --pull=newer, because the wrapper is the path where nobody thinks about
    # pulling. Podman's default (--pull=missing) would run whatever copy was
    # first fetched, forever; the tool bakes in its own action pins and
    # template snapshots, so a stale image quietly generates repos from stale
    # pins. This fetches only when the registry digest differs, and podman
    # suppresses pull errors when a local image exists, so an offline run
    # still works.
    podman_args+=(--pull=newer)
else
    if ! command -v cosign >/dev/null 2>&1; then
        echo "aib: cosign is required to verify $AIB_IMAGE before running it." >&2
        echo "aib: install cosign from https://docs.sigstore.dev/cosign/system_config/installation/," >&2
        echo "aib: or set AIB_SKIP_VERIFY=1 to run without verifying the signature." >&2
        exit 1
    fi

    # Pull first so there is a concrete digest to verify, then run that exact
    # digest. Failing closed here is deliberate: a pull failure is also how an
    # offline run arrives, and running an unverified image is not the right
    # default for either.
    if ! podman pull --quiet "$AIB_IMAGE" >/dev/null; then
        echo "aib: could not pull $AIB_IMAGE, so its signature cannot be verified." >&2
        echo "aib: set AIB_SKIP_VERIFY=1 to run an already-pulled copy offline." >&2
        exit 1
    fi

    digest=""
    if ! digest="$(podman image inspect --format '{{.Digest}}' "$AIB_IMAGE" 2>/dev/null)"; then
        digest=""
    fi
    # Exactly a sha256 digest, not merely something starting "sha256:". This
    # value is interpolated into the reference both cosign and podman are
    # given, and a truncated or padded one could resolve differently for each
    # -- which would mean verifying one image and running another.
    if ! [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
        echo "aib: could not determine the digest of $AIB_IMAGE; refusing to run unverified." >&2
        exit 1
    fi

    verified_ref="$AIB_PUBLISHED_REPO@$digest"
    if ! cosign_output="$(cosign verify \
        --certificate-identity-regexp "$AIB_CERT_IDENTITY" \
        --certificate-oidc-issuer "$AIB_CERT_ISSUER" \
        "$verified_ref" 2>&1)"; then
        echo "aib: SIGNATURE VERIFICATION FAILED for $verified_ref" >&2
        echo "aib: refusing to run it. This image is not one this project published," >&2
        echo "aib: or its signature could not be checked. cosign said:" >&2
        printf '%s\n' "$cosign_output" >&2
        exit 1
    fi

    # Run the digest that was verified, not the tag that resolved to it.
    run_image="$verified_ref"
fi

# --- GitHub auth -------------------------------------------------------
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    GH_TOKEN="$(gh auth token)"
    export GH_TOKEN
    podman_args+=(-e GH_TOKEN)
else
    podman_args+=(-v "aib-gh:/root/.config/gh")
fi

# --- OS scan support -----------------------------------------------------
status_file=""
# Invoked indirectly via `trap cleanup EXIT` below, which shellcheck cannot
# see. Both codes are needed: 0.10+ reports SC2329 on the function, older
# versions (the ubuntu-24.04 runner ships 0.9.0) report SC2317 on its body.
# shellcheck disable=SC2317,SC2329
cleanup() {
    if [ -n "$status_file" ]; then
        rm -f "$status_file"
    fi
}
trap cleanup EXIT

if command -v rpm-ostree >/dev/null 2>&1; then
    status_file="$(mktemp)"
    if rpm-ostree status --json >"$status_file" 2>/dev/null; then
        # One push per argument, matching every other call site in this file.
        # A multi-line array literal reads as two uncovered lines under
        # bashcov, which attributes a hit only to the line a statement starts
        # on -- see issue #118.
        podman_args+=(-v "${status_file}:/run/aib-rpm-ostree-status.json:ro,Z")
        podman_args+=(-e "AIB_RPM_OSTREE_STATUS_FILE=/run/aib-rpm-ostree-status.json")
    else
        rm -f "$status_file"
        status_file=""
    fi
fi

# --- Package search metadata ---------------------------------------------
# The container runs as root, so dnf5 caches metadata under /var/cache/libdnf5.
podman_args+=(-v "aib-dnf-cache:/var/cache/libdnf5")

# --- Nice-to-haves ---------------------------------------------------------
if [ -e /etc/localtime ]; then
    podman_args+=(-v "/etc/localtime:/etc/localtime:ro")
fi

# Not `exec`: the EXIT trap above must fire to clean up the temp status
# file, and `exec` would replace this shell (and its pending trap) with
# podman before that could happen. Preserve podman's exit code as our own.
podman run "${podman_args[@]}" "$run_image" "$@"
exit $?
