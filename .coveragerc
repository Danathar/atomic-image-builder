# Coverage settings for CI and local runs.
#
# Keep this in sync with the two modules that ship in the image: the tool
# itself and the maintenance audit helper. Tests are deliberately excluded
# from measurement — covering the test file tells us nothing.

[run]
source =
    atomic_image_builder
    homebrew_formula
    maintenance_audit
# Store paths relative to the checkout instead of absolute. Without this the
# data file records the runner's workspace path, which makes the coverage
# artifact useless anywhere but that runner -- see .coveragerc.e2e.
relative_files = True
# Statement coverage alone marks an `if` line "covered" the moment either
# side runs once, so a branch that always goes one way reads identical to one
# that's genuinely tested both ways. Branch tracking was off, and it was
# hiding real gaps: 44 partial branches surfaced the moment it was turned on
# locally, on a codebase this file already reported as 100% covered.
branch = True

[report]
show_missing = True
precision = 0
exclude_also =
    # The __main__ guard can only run when the file is executed directly,
    # which the unittest suite never does.
    if __name__ == .__main__.:
