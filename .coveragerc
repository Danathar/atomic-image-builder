# Coverage settings for CI and local runs.
#
# Keep this in sync with the modules under unit test: the tool itself, the
# maintenance/release helpers, and coverage_badge (a CI-only helper -- see
# CONTRIBUTING.md's Coverage section -- not shipped in the image or run by
# the maintenance-audit job, so it has no e2e or maintenance-audit coverage
# of its own; snapshot_drift_issue is the same, run only by the weekly audit
# job); format_markdown_tables is a contributor-facing helper with the same
# shape, run from a checkout and never from the image. Tests are deliberately
# excluded from measurement — covering the test file tells us nothing.
#
# A module missing from this list lowers no percentage, so the gap is silent.
# test_every_top_level_module_is_measured_by_the_unit_gate in
# tests/test_format_markdown_tables.py compares this list against the tracked
# root modules so a new one cannot go unmeasured unnoticed.

[run]
source =
    atomic_image_builder
    homebrew_formula
    maintenance_audit
    coverage_badge
    snapshot_drift_issue
    format_markdown_tables
# Store paths relative to the checkout instead of absolute. Without this the
# data file records the runner's workspace path, which makes the coverage
# artifact useless anywhere but that runner -- see .coveragerc.e2e.
relative_files = True
# Statement coverage alone marks an `if` line "covered" the moment either
# side runs once, so a branch that always goes one way reads identical to one
# that's genuinely tested both ways. Branch tracking was off, and it was
# hiding real gaps: 44 partial branches surfaced the moment it was turned on
# locally, on a codebase this file already reported as 100% covered.
branch = True

[report]
show_missing = True
precision = 0
exclude_also =
    # The __main__ guard can only run when the file is executed directly,
    # which the unittest suite never does.
    if __name__ == .__main__.:
