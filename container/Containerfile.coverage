# CI-only overlay that makes the published image measurable.
#
# The unit suite runs against the source tree, which tells us nothing about
# which lines a real run of the *packaged* entrypoint executes. This image
# adds coverage.py on top of the built tool image and replaces the
# /usr/local/bin/atomic-image-builder launcher with a shim that runs the
# packaged script under it, so container/entrypoint.sh and the whole
# packaged path stay in the measured run instead of being bypassed.
#
# Built and used only by .github/workflows/ci.yml. It is never pushed, and
# publish-image.yml does not know about it -- keep it that way, coverage.py
# has no business in the released image.
ARG BASE_IMAGE=aib-ci-test
FROM ${BASE_IMAGE}

RUN dnf5 -y install python3-coverage && dnf5 clean all

# The launcher in the base image is a symlink to the script; replace it with
# a shim so `atomic-image-builder "$@"` still works for entrypoint.sh. The
# data file location comes from COVERAGE_FILE at run time, which the CI job
# points at a bind-mounted directory so each scenario lands in its own file.
#
# --branch is passed explicitly because nothing here reads .coveragerc: only
# the script and its snapshots are COPY'd into the image, so the shim runs with
# no rcfile at all. Without it the e2e data is statement-only and cannot be
# merged with the unit data, which coverage rejects outright rather than
# degrading.
RUN rm -f /usr/local/bin/atomic-image-builder && \
    printf '%s\n' \
      '#!/bin/bash' \
      'exec python3 -m coverage run --branch --source=/opt/atomic-image-builder /opt/atomic-image-builder/atomic_image_builder.py "$@"' \
      > /usr/local/bin/atomic-image-builder && \
    chmod +x /usr/local/bin/atomic-image-builder
